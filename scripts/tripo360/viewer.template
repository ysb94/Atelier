<!doctype html><html lang="ko"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tripo 3D · 70방향 로컬 검수</title>
<style>body{font-family:system-ui;margin:24px auto;padding:0 16px;max-width:1000px;color:#222}button,a{padding:10px;border:1px solid #bbb;border-radius:8px;background:white;color:inherit;cursor:pointer}button:disabled{opacity:.5}#stage{max-width:700px;margin:auto;touch-action:pan-y}canvas{width:100%;display:block;border:1px solid #ddd;border-radius:12px}input{width:100%}.controls{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}#thumbs{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:4px}#thumbs img{width:100%}</style>
<h1>Tripo 3D · 70방향 로컬 검수</h1><p>사진 네 장으로 생성한 동일한 3D 모델을 회전합니다. 이 화면은 유료 생성 API를 호출하지 않습니다.</p><p id="status" role="status">로컬 모델 불러오는 중…</p>
<div id="stage"></div><input id="angle" aria-label="회전 각도" type="range" min="0" max="69" value="0"><output id="label">1 / 70</output>
<div class="controls"><button id="play" disabled>자동 회전</button><button id="capture" disabled>70개 각도 추출 · AI 비용 없음</button><button id="zip" disabled>70장 ZIP 다운로드</button><a href="/model.glb" download="atelier-test.glb">3D 모델 GLB 다운로드</a></div>
<p>3D 변환으로 원본의 무늬·로고·끈·형태가 바뀔 수 있습니다. 상품 사진과 직접 비교하세요. 결과와 키는 로컬 PC에만 보관하며 생성 시 원본 사진은 Tripo에 전송됩니다.</p><div id="thumbs"></div>
<script src="/jszip.js"></script><script type="importmap">{"imports":{"three":"/three.module.js"}}</script>
<script type="module">
import * as THREE from 'three';import {GLTFLoader} from '/GLTFLoader.js';
const status=document.getElementById('status'),slider=document.getElementById('angle'),play=document.getElementById('play'),capture=document.getElementById('capture'),zipButton=document.getElementById('zip'),stage=document.getElementById('stage');let timer=null,frames=[],index=0,taskInfo=null;const params=new URLSearchParams(location.search),job=params.get('job');if(job&&!/^[a-z0-9-]{8,64}$/.test(job))throw Error('잘못된 작업 ID');const base=job?'/job/'+job:'';
const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});renderer.setSize(960,960,false);renderer.setPixelRatio(1);renderer.outputColorSpace=THREE.SRGBColorSpace;stage.append(renderer.domElement);
const scene=new THREE.Scene();scene.background=new THREE.Color('white');const camera=new THREE.OrthographicCamera(-1.8,1.8,1.8,-1.8,.01,100);camera.position.set(0,.15,5);camera.lookAt(0,0,0);
scene.add(new THREE.HemisphereLight(0xffffff,0xb7b7b7,2));for(const [x,y,z,power] of [[3,4,5,2],[-3,2,-4,1.5]]){const light=new THREE.DirectionalLight(0xffffff,power);light.position.set(x,y,z);scene.add(light)}const pivot=new THREE.Group();scene.add(pivot);
function show(value){index=(Number(value)+70)%70;slider.value=index;pivot.rotation.y=-Math.PI/2+index*2*Math.PI/70;renderer.render(scene,camera);document.getElementById('label').textContent=`${index+1} / 70 · ${(index*360/70).toFixed(2)}°`;}
function download(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),60000)}
try{const gltf=await new GLTFLoader().loadAsync(base+'/model.glb');const object=gltf.scene,bounds=new THREE.Box3().setFromObject(object),center=bounds.getCenter(new THREE.Vector3()),size=bounds.getSize(new THREE.Vector3());object.position.sub(center);pivot.add(object);pivot.scale.setScalar(2/Math.max(size.x,size.y,size.z));show(0);play.disabled=capture.disabled=false;const task=await(await fetch(base+'/status')).json();taskInfo=task;document.querySelector('a[download]').href=base+'/model.glb';status.textContent=`3D 모델 생성 완료 · ${task.credits??'조회 없음'}크레딧 · 70개 각도는 로컬 렌더링`;window.modelReady=true;window.showAngle=show;
}catch(error){console.warn('[tripo360] 모델 표시 실패',error);status.textContent='모델 표시 실패: '+error.message;window.modelError=error.message;}
slider.oninput=()=>show(slider.value);let start=null;stage.onpointerdown=e=>{start={x:e.clientX,index};stage.setPointerCapture(e.pointerId)};stage.onpointermove=e=>{if(start)show(start.index+Math.round((e.clientX-start.x)/stage.clientWidth*70))};stage.onpointerup=stage.onpointercancel=()=>{start=null};
play.onclick=()=>{if(timer){clearInterval(timer);timer=null;play.textContent='자동 회전'}else{timer=setInterval(()=>show(index+1),50);play.textContent='회전 멈춤'}};
capture.onclick=async()=>{if(timer){clearInterval(timer);timer=null;play.textContent='자동 회전'}capture.disabled=play.disabled=true;zipButton.disabled=true;frames=[];try{for(let i=0;i<70;i++){show(i);frames.push(renderer.domElement.toDataURL('image/png'));status.textContent=`로컬 각도 추출 ${i+1}/70`;await new Promise(r=>setTimeout(r,0))}document.getElementById('thumbs').replaceChildren(...frames.map((src,i)=>{const img=new Image();img.src=src;img.alt=`${i+1}번째 각도`;img.onclick=()=>show(i);return img}));zipButton.disabled=false;status.textContent='70개의 서로 다른 목표 각도 추출 완료 · 추가 AI 요청 없음';window.framesReady=frames;show(0);if(job){const response=await fetch(base+'/frames',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({frames})});if(!response.ok)throw Error('70방향 로컬 저장 실패');status.textContent='사이트 파일 저장소에 보관 중…';const saved=await fetch(base+'/publish',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});const result=await saved.json();if(!saved.ok)throw Error(result.error||'사이트 저장 실패');status.textContent='사이트 저장 완료 · 다른 PC에서도 저장 결과를 볼 수 있습니다.';parent.postMessage({type:'tripo-saved',id:job},'*')}}catch(e){console.warn('[tripo360] 각도 추출 실패',e);status.textContent=e.message}finally{capture.disabled=play.disabled=false}};
zipButton.onclick=async()=>{zipButton.disabled=true;try{const zip=new JSZip(),metadata=[];for(let i=0;i<70;i++){zip.file(`frames/${String(i).padStart(3,'0')}.png`,frames[i].split(',')[1],{base64:true});metadata.push({index:i,angle:i*360/70,source:'same-3d-model'})}zip.file('manifest.json',JSON.stringify({frameCount:70,step:360/70,model:'model.glb',frames:metadata},null,2));zip.file('model.glb',await(await fetch(base+'/model.glb')).arrayBuffer());zip.file('viewer.html',`<!doctype html><meta charset="utf-8"><title>70방향 제품 보기</title><style>body{max-width:800px;margin:auto}img,input{width:100%}</style><img id="p" src="frames/000.png"><input aria-label="회전" type="range" min="0" max="69" value="0" oninput="document.getElementById('p').src='frames/'+String(this.value).padStart(3,'0')+'.png'">`);download(await zip.generateAsync({type:'blob'}),'tripo-70-views.zip')}catch(e){console.warn('[tripo360] ZIP 저장 실패',e);status.textContent=e.message}finally{zipButton.disabled=false}};
if(job&&params.get('auto')==='1'&&taskInfo?.frameCount!==70&&window.modelReady)capture.click();
</script></html>
