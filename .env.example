# Supabase 연결 정보. 실제 값은 .env.local에 넣는다(.gitignore의 *.local로 제외됨).
# Dashboard -> API Keys 에서 확인한다.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# 브라우저에 노출되어도 되는 키만 사용한다. publishable(sb_publishable_...) 또는 legacy anon 키.
# Secret / service_role 키는 절대 여기에 넣지 않는다.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# DEV LOGIN — 개발 중에만 사용. 배포 전에 지우세요.
# VITE_DEV_LOGIN_EMAIL=dev@atelier.local
# VITE_DEV_LOGIN_PASSWORD=atelier-dev-login
